#!/usr/bin/env bash

# Runs mametest over all of the specified files and presents the
# results in a web browser. If no files are specified, a standard list
# of directories is used.
#
# Syntax:
#
# bin/testpass [options] [testfiles]
#
# Options
#
#    --dirty             Use 'git diff' to select files
#    --add-if-pass       If a test file passes, 'git add'
#

cd "$(dirname "$0")/.."
source "bin/util.sh"

START="$(date)"

DEFAULT_FILES="\
    tests/screenshots/*.lua \
    tests/configs/*.lua \
    tests/launcher/*.lua \
    tests/desktop/*.lua \
    tests/disk_copy/*.lua \
    tests/selector/*.lua \
    tests/desk_acc/*.lua \
    tests/*.lua"

FILES=""
FLAGS="--nosnaps"
ADD_IF_PASS=""
for arg in "$@"; do
  case $1 in
    --dirty)
      shift;
      FILES=$(git diff --name-only $DEFAULT_FILES)
      if [ -z "$FILES" ]; then
        echo "No dirty files" 1>&2
        exit 1
      fi
      ;;
    --visible)
      shift;
      FLAGS="$FLAGS --visible"
      ;;
    --add-if-pass)
      shift;
      ADD_IF_PASS=true
      ;;
    *)
      break
      ;;
  esac
done

if [ -z "$FILES" ]; then
  if [ $# -gt 0 ]; then
    FILES="$@"
  else
    FILES="$DEFAULT_FILES"
  fi
fi

TMPDIR="/tmp/mametest"
results="$TMPDIR/results"
mkdir -p "$results"
for file in index.html index.js; do
  ln -sf $(realpath "res/testutil/$file") "$results/$file"
done
MANIFEST="$results/manifest.txt"
rm -f "$MANIFEST"

for i in $FILES
do
  cecho yellow "==$i=="

  SCRIPT="$(realpath "$i")"
  SCRIPTDIR="$(dirname "$SCRIPT")"

  bin/mametest $FLAGS "$SCRIPT"
  if [ $? -eq 0 -a "$ADD_IF_PASS" ]; then
    git add "$SCRIPT"
  fi

  relpath="${SCRIPT#$(pwd)/tests/}"
  resdir="$(dirname "$relpath")"
  zipfile="${resdir}/$(basename "$SCRIPT" .lua).zip"

  echo "$zipfile" >> "$MANIFEST"
done

echo "Start: $START"
echo "End: $(date)"

# Serve the results. We must enable job control so the server can be
# started in the background, then we open a browser, then we
# foreground the server so it can be terminated with Ctrl+C.
set -m
python3 -m http.server -d "$results" 8000 2> /dev/null &
sleep 1
echo ""
cecho green "Serving results at http://localhost:8000 - Ctrl+C to stop"
echo ""
open http://localhost:8000
fg > /dev/null
